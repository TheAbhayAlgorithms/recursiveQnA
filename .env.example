# ==============================================================================
# RecursiveQnA - Environment Variables Configuration
# ==============================================================================

# 1. Supabase PostgreSQL Database (Required for Production / Vercel deployment)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooler)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# 2. Supabase API & Storage Configuration (Required for cloud image/video uploads)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 3. JWT Security Secret (Used for scholarly session cookies)
JWT_SECRET=recursiveqna-production-secure-random-secret-key-2026

# ==============================================================================
# 4. Google OAuth Authentication (Supabase Auth)
# ==============================================================================
# Enable Google provider in Supabase Dashboard:
# Authentication -> Providers -> Google (Provide Client ID & Client Secret from Google Cloud Console)
# Redirect URL in Google Cloud Console: https://[YOUR-PROJECT-REF].supabase.co/auth/v1/callback


# SMTP Server Hostname (e.g. smtp.gmail.com, smtp-relay.brevo.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP Port: 587 (STARTTLS) or 465 (SSL/TLS)
SMTP_PORT=587

# SMTP Authentication Username / Email Address
SMTP_USER=your-email@gmail.com

# SMTP Authentication Password (e.g. 16-character Gmail App Password or Brevo Master Key)
SMTP_PASS=your-16-char-app-password

# Email Sender Address & Display Name
EMAIL_FROM="RecursiveQnA Security" <no-reply@recursiveqna.org>

# ==============================================================================
# 5. Google Gemini AI Verification (Server-Side Only - Add in Vercel Dashboard)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

